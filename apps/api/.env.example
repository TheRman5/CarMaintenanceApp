# Local milestone only. DO NOT deploy the API until authentication is enabled.
APP_ENV=development
DATABASE_URL=sqlite:///./garage.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For hosted reminders, use a Supabase Postgres URL in GitHub Actions secret DATABASE_URL.
# GitHub Actions secrets only, never commit real values:
# RESEND_API_KEY=
# REMINDER_EMAIL_FROM=Garage Alerts <reminders@your-verified-domain.example>
# REMINDER_EMAIL_TO=you@example.com
# REMINDER_WARNING_DAYS=30
# REMINDER_WARNING_MILES=500
